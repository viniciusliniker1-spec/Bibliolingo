{
  "expo": {
    "name": "Bibliolingo",
    "slug": "bibliolingo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "bibliolingo",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#21A675",
          "defaultChannel": "study-reminders"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Bibliolingo use a biometria para proteger sua conta."
        }
      ]
    ],
    "android": {
      "package": "com.bibliolingo.app",
      "adaptiveIcon": {
        "backgroundColor": "#eef4f8"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.bibliolingo.app",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
