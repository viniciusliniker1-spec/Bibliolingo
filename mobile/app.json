{
  "expo": {
    "name": "Bibliolingo",
    "slug": "bibliolingo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "bibliolingo",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#21A675",
          "defaultChannel": "study-reminders",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Bibliolingo use a biometria para proteger sua conta."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o Bibliolingo acesse suas fotos para escolher sua imagem de perfil.",
          "cameraPermission": false
        }
      ],
      "expo-image",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LumiStreak",
              "label": "Lumi · Sequência",
              "description": "A Lumi lembra da sua sequência e da meta do dia.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "240dp",
              "previewImage": "./assets/widget/lumi_widget_preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-sharing",
      [
        "./plugins/withLumiNotificationIcon",
        {
          "image": "./assets/generated/moods/lumi_mood_ideia.png"
        }
      ]
    ],
    "android": {
      "package": "com.bibliolingo.app",
      "adaptiveIcon": {
        "backgroundColor": "#02381b",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.bibliolingo.app",
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "owner": "viniciuslyneker",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53a20acb-70d5-4a73-8161-26979dc67a64"
      }
    }
  }
}
