# URL pública do backend; não é segredo.
VITE_NOAH_API_URL=

# Feature flag: defina como false para conservar o tutor anterior sem os gatilhos contextuais.
VITE_NOAH_CONTEXTUAL_ENABLED=true

# Opcional: chave pública do Cloudflare Turnstile.
VITE_TURNSTILE_SITE_KEY=

# Segredos exclusivos do Cloudflare Worker/GitHub Actions:
# GEMINI_API_KEY (provedor principal) e GROQ_API_KEY (contingência).
# Nunca use prefixo VITE_ nessas chaves e nunca as envie ao frontend.
